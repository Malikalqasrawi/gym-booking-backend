# Copy to local.properties (git-ignored) and fill in.

# Set by scripts/create-db-user.sh
spring.datasource.password=PUT_YOUR_MYSQL_PASSWORD_HERE

# Base64-encoded, at least 64 bytes: openssl rand -base64 64 | tr -d '\n'
app.jwt.secret=PUT_A_RANDOM_BASE64_SECRET_HERE

# Password for the first admin account (admin@gym.com). Leave it out to get a random one in the log.
#app.admin.initial-password=CHOOSE_A_STRONG_PASSWORD

# Google sign-in: the "Web application" client ID from Google Cloud (leave out to turn it off)
#app.auth.google.client-id=123456789-abc.apps.googleusercontent.com

# Stripe test-mode keys (live keys are rejected)
#app.payments.stripe.secret-key=sk_test_...
#app.payments.stripe.publishable-key=pk_test_...
# From `stripe listen` (optional)
#app.payments.stripe.webhook-secret=whsec_...

# Real text messages (SMS) for phone codes, from Twilio Verify (leave out to see the codes in the log)
#app.sms.twilio.account-sid=AC...
#app.sms.twilio.auth-token=your-auth-token
#app.sms.twilio.verify-service-sid=VA...

# Real emails through Gmail (leave out to see emails in the log instead). The password is a
# 16-letter app password from myaccount.google.com/apppasswords, not your Google password.
#app.notifications.mode=email
#spring.mail.username=your.address@gmail.com
#spring.mail.password=your-app-password
# Another SMTP server instead of Gmail:
#spring.mail.host=smtp.example.com
#spring.mail.port=587
