# ---- Build output (made again by every build) ----
target/

# ---- Local data (test database files) ----
data/

# ---- SECRETS: never on GitHub ----
# local.properties holds the MySQL password, the JWT secret and the Stripe keys.
# The * also catches copies like local.properties.bak; the example file (no real values) is allowed.
local.properties*
!local.properties.example
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore

# ---- Editor / OS files ----
nbactions.xml
nb-configuration.xml
.idea/
*.iml
.vscode/
*.log
.DS_Store

# ---- Copies of files the Claude app saved here (not part of the project) ----
Claude outputs/
