# Used by docker compose. Copy to .env (git-ignored) and fill in.

# e.g. openssl rand -hex 16
DB_PASSWORD=
DB_ROOT_PASSWORD=

# openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Optional: password for the first admin account (admin@gym.com); random and logged once if empty
ADMIN_PASSWORD=

# Optional: Google sign-in, the "Web application" client ID from Google Cloud
GOOGLE_CLIENT_ID=

# Optional: real emails through Gmail. Set EMAIL_MODE=email, your Gmail address and an app
# password (not your Google password). Without them, emails are written to the log.
EMAIL_MODE=
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional: Stripe test-mode keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
