# Used by docker compose. Copy to .env (git-ignored) and fill in.

# e.g. openssl rand -hex 16
DB_PASSWORD=
DB_ROOT_PASSWORD=

# openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Encrypts two-factor secrets in the database: openssl rand -base64 32
ENCRYPTION_KEY=

# Password for the first admin account (admin@gym.com); no admin is created while it's empty
ADMIN_PASSWORD=

# true on a real server: refuses to start with emails or SMS codes going to the log, or with the
# demo trainers on. Leave false (or empty) to try things out.
PRODUCTION=

# true to add the 22 demo trainers (password Trainer1234) for trying the app. Never on a real server.
SEED_DEMO_TRAINERS=

# Optional: Google sign-in, the "Web application" client ID from Google Cloud
GOOGLE_CLIENT_ID=

# Optional: real emails through Gmail. Set EMAIL_MODE=email, your Gmail address and an app
# password (not your Google password). Without them, emails are written to the log.
EMAIL_MODE=
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional: real SMS for phone codes, from Twilio Verify. Without them, codes are written to the log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional: Stripe test-mode keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
