# ------------------------------------------------------------------
#  Settings for "docker compose up". Copy this file to ".env" and fill it in:
#      cp .env.example .env
#  .env is in .gitignore, so your values never reach GitHub. Never put real values in THIS file.
# ------------------------------------------------------------------

# Passwords for the MySQL inside Docker (make up two long random ones, e.g.  openssl rand -hex 16)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Signs login tokens. Make one with:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Optional: Stripe TEST keys (Dashboard → Developers → API keys). Without them, paying says "not set up yet".
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
